# ==============================================================================
# NeuroPath Backend - Staging Environment Configuration (.env.staging)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in neuropath-backend/ on your staging server:
#      cp .env.staging.example .env
# 2. Update with staging domain names, database credentials, and production AI keys.
# ==============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
# In staging, DEBUG must be False.
DEBUG=False

# Replace with a cryptographically secure random 50+ character string.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=neuropath-staging-secret-key-replace-with-random-50-chars-in-deployment

# Hostnames/IPs this backend answers for.
# Must include staging API domain, load balancer IP, and internal IPs.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],staging-api.neuropath.app

# ── Database (PostgreSQL / Supabase) ──────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.mdlsncdlpgbfjcccavuv
DB_PASSWORD=NeuroPathCS342-14
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432

# ── Hosts & Origins (CORS & CSRF) ─────────────────────────────────────────────
# Scheme + host (+ port if non-standard), NO trailing slash.
# Must match the URL of the deployed staging React frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://staging.neuropath.app

# Trusted origins for CSRF protection.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://staging.neuropath.app,https://staging-api.neuropath.app

# ── AI Services Configuration ─────────────────────────────────────────────────
# NeuroPath uses a multi-tier fallback cascade: Gemini -> Groq -> OpenRouter -> Ollama
# Provide at least GEMINI_API_KEY (Tier 1) or GROQ_API_KEY (Tier 2).

# Tier 1: Primary AI Generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tier 2: Groq Cloud Fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tier 3: OpenRouter Universal Gateway Fallback (Optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Tier 4: Local Ollama (Optional - usually only for local staging / self-hosted)
# OLLAMA_HOST=http://localhost:11434

# Legacy HuggingFace Token (Optional)
HF_TOKEN=
