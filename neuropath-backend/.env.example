# Copy this file to .env in this directory (neuropath-backend/.env) and fill in real values.
# Django reads this via django-environ (see neuropath_core/settings.py).

# ── Database ──────────────────────────────────────────────────────────────────
# Required. No default — the app will not start without this.
DB_PASSWORD=

# Optional overrides. If unset, they fall back to the hardcoded Supabase
# pooler values in settings.py. Set these to point at a local/throwaway
# Postgres instance instead (this is what CI does).
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres

# ── Hosts & origins ───────────────────────────────────────────────────────────
# Optional, comma-separated. Defaults cover local development, so you only need
# these to serve the backend or frontend from a non-localhost address.
#
# ALLOWED_HOSTS       — hostnames/IPs this backend answers for.
# CORS_ALLOWED_ORIGINS — origins the React app is served from (scheme + host +
#                        port, no trailing slash). Must include the frontend's
#                        real origin or the browser blocks every API call.
# CSRF_TRUSTED_ORIGINS — same list; only matters for session/form POSTs.
#
# Example for a backend on a LAN IP with the Vite dev server on the same box:
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.50
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.50:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://192.168.1.50:5173

# ── AI services ───────────────────────────────────────────────────────────────
# Optional. Falls back to a placeholder string if unset (features relying on
# it will fail at call time, not at startup).
HF_TOKEN=
GROQ_API_KEY=

# Optional. Only needed if your local Ollama server isn't the default
# http://localhost:11434 (read directly by the ollama Python client, not by
# django-environ).
# OLLAMA_HOST=http://localhost:11434
