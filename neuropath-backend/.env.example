# Copy this file to .env in this directory (neuropath-backend/.env) and fill in real values.
# Django reads this via django-environ (see neuropath_core/settings.py).

# ── Django Core ───────────────────────────────────────────────────────────────
# In production, set a strong, random secret key (e.g. generate via `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
# In development, a safe placeholder default is provided if left unset.
# SECRET_KEY=

# Set to True for local development; defaults to False for safety in production.
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────────
# Database engine. Defaults to django.db.backends.postgresql.
# Set to django.db.backends.sqlite3 for a local SQLite file (e.g. with DB_NAME=db.sqlite3).
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432

# ── Hosts & origins ───────────────────────────────────────────────────────────
# Optional, comma-separated. Defaults cover local development, so you only need
# these to serve the backend or frontend from a non-localhost address.
#
# ALLOWED_HOSTS       — hostnames/IPs this backend answers for.
# CORS_ALLOWED_ORIGINS — origins the React app is served from (scheme + host +
#                        port, no trailing slash). Must include the frontend's
#                        real origin or the browser blocks every API call.
# CSRF_TRUSTED_ORIGINS — same list; only matters for session/form POSTs.
#
# Example for a backend on a LAN IP with the Vite dev server on the same box:
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.50
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.50:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://192.168.1.50:5173

# ── AI services ───────────────────────────────────────────────────────────────
# NeuroPath uses a resilient multi-tier AI cascade (Gemini -> Groq -> OpenRouter -> Ollama).
# Configure at least GEMINI_API_KEY for primary generation.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Tier 2: Groq Cloud Fallback
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Tier 3: OpenRouter Universal Gateway Fallback
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Tier 4: Local Ollama Fallback (Optional)
# Only needed if your local Ollama server isn't the default http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# Legacy HuggingFace Token (Optional)
HF_TOKEN=

