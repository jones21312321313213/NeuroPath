# ==============================================================================
# NeuroPath Frontend - Staging Environment Configuration (.env.staging)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in neuropath-frontend/ before building the frontend:
#      cp .env.staging.example .env
# 2. Vite injects VITE_-prefixed variables at BUILD TIME (npm run build).
# ==============================================================================

# Base URL of the staging backend API (must include the /api prefix, no trailing slash).
VITE_API_URL=https://staging-api.neuropath.app/api
